{
  "mcpServers": {
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "@figma/mcp-server"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "YOUR_FIGMA_TOKEN_HERE"
      }
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/mcp-server"
      ],
      "env": {
        "NOTION_API_KEY": "YOUR_NOTION_KEY_HERE"
      }
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "@linear/mcp-server"
      ],
      "env": {
        "LINEAR_API_KEY": "YOUR_LINEAR_KEY_HERE"
      }
    },
    "posthog": {
      "command": "npx",
      "args": [
        "-y",
        "@posthog/mcp-server"
      ],
      "env": {
        "POSTHOG_API_KEY": "YOUR_POSTHOG_KEY_HERE"
      }
    }
  }
}
